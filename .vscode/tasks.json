{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure SDL Sim",
      "type": "shell",
      "command": "bash",
      "args": [
        "./run_cmake_sdl_sim.sh"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Build SDL Sim",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/build_sdl_sim"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "Configure SDL Sim"
    }
  ]
}

