{
  "version": 3,
  "configurePresets": [
    {
      "name":           "simulator",
      "displayName":    "SDL Simulation",
      "description":    "Configure for SDL_SIMULATOR into build_sdl_sim/",
      "generator":      "Unix Makefiles",
      "binaryDir":      "${sourceDir}/build_sdl_sim",
      "cacheVariables": {
        "TARGET":                          "SDL_SIMULATOR",
        "CMAKE_BUILD_TYPE":                "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS":   "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name":           "simulator",
      "configurePreset":"simulator",
      "description":    "Build the SDL Simulation",
      "configuration":  "simulator"
    }
  ]
}
